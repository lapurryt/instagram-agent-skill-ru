 "structures": [
  {
   "id": "not-just",
   "regex": "(?i)\\b(?:это )?не просто\\b[^.!?\\n]{2,60}[,.]\\s*(?:а|это)\\b",
   "name": "«Не просто X, а Y»",
   "fix": "Скажи одно, что ты на самом деле имеешь в виду. Половину с подводкой удали"
  },
  {
   "id": "not-only",
   "regex": "(?i)\\bне только\\b[^.!?\\n]{2,80}\\bно и\\b",
   "name": "«Не только X, но и Y»",
   "fix": "Раздели на два предложения или убери слабую половину"
  },
  {
   "id": "isnt-about",
   "regex": "(?i)\\b(?:дело|речь|суть) не (?:в|о|про)\\b[^.!?\\n]{2,60}[.!,]\\s*(?:а |дело |речь |суть )?(?:в|о|про)\\b",
   "name": "«Дело не в X. Дело в Y»",
   "fix": "Начни с Y. Разворот и есть примета"
  },
  {
   "id": "the-result",
   "regex": "(?im)^\\s*(?:результат|итог|подвох|самое интересное|самое главное|что в итоге)\\?\\s*$",
   "name": "Риторический вопрос одной строкой",
   "fix": "Ответь в той же фразе, без постановки разгадки"
  },
  {
   "id": "heres-what",
   "regex": "(?i)\\bвот (?:что|чему) я (?:понял|поняла|узнал|узнала|научился|научилась|вынес|вынесла)\\b",
   "name": "«Вот что я понял»",
   "fix": "Скажи сам вывод. Объявление вывода пропусти"
  },
  {
   "id": "triad",
   "regex": "(?i)\\b\\w+, \\w+ и \\w+\\.",
   "name": "Тройка «X, Y и Z.»",
   "fix": "Два пункта или четыре. Три это любимый ритм модели"
  },
  {
   "id": "rocket",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
   "name": "Эмодзи ракета / огонь / лампочка / искры / мишень",
   "fix": "Максимум одно эмодзи и не из этих пяти"
  },
  {
   "id": "hashtag-wall",
   "regex": "(?:#\\w+[ \\t]*){5,}",
   "name": "Стена хештегов (5 и больше)",
   "fix": "Три хештега. Instagram не награждает стену, лимит пять"
  },
  {
   "id": "as-an-ai",
   "regex": "(?i)\\bкак (?:языковая модель|ии[- ]ассистент|ии-модель|искусственный интеллект, я)\\b",
   "name": "Модель говорит о себе",
   "fix": "Удали предложение"
  },
  {
   "id": "in-summary",
   "regex": "(?im)^\\s*(?:в заключение|подводя итог\\w*|подытожим|подведём итоги|подведем итоги|резюмируя)\\b",
   "name": "Зачин школьного вывода",
   "fix": "Посту не нужен заключительный абзац"
  },
  {
   "id": "engagement-bait",
   "regex": "(?im)(?:согласн[ыа]\\?|как (?:думаете|считаете)\\?|кто со мной\\?|я не прав\\?|я не права\\?|а (?:вы|ты) что думае(?:те|шь)\\?)\\s*$",
   "name": "Дежурная наживка на комментарии",
   "fix": "Задай вопрос, который можешь задать только ты, про конкретную вещь выше"
  },
  {
   "id": "stop-scroll",
   "regex": "(?im)^\\s*(?:стоп[!.,]|не листай|не пролистывай|остановись|подожди[,.]? не листай)",
   "name": "Зачин «Стоп, не листай»",
   "fix": "Останавливать должна сама мысль. Просьба о внимании выдаёт, что ты его не заслужил"
  },
  {
   "id": "in-this-video",
   "regex": "(?i)\\b(?:в (?:этом|сегодняшнем) (?:видео|ролике|рилсе|посте) я|сегодня я (?:расскажу|покажу)|сейчас я (?:расскажу|покажу) вам|я (?:покажу|расскажу) вам,? как)\\b",
   "name": "Предисловие («в этом видео я покажу»)",
   "fix": "Удали и начни с главного. Первые две секунды решают весь рилс"
  },
  {
   "id": "emoji-bullets",
   "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
   "name": "Список с эмодзи вместо пунктов",
   "fix": "Дефис или перенос строки. Эмодзи-пункты самое шаблонное, что бывает в подписи"
  },
  {
   "id": "caps-shout",
   "regex": "\\b[A-ZА-ЯЁ]{3,}\\b(?:\\s+\\b[A-ZА-ЯЁ]{3,}\\b){2,}",
   "name": "Три и больше слов капсом подряд",
   "fix": "Капс это громкость, а не маркер. Одно слово, не больше"
  },
  {
   "id": "follow-bait",
   "regex": "(?i)\\b(?:подпиш(?:ись|итесь),? чтобы не пропустить|став(?:ь|ьте) лайк|отметь(?:те)? (?:друга|подругу|того),? (?:кому|которому|которой)|поделись(?:тесь)? с тем,? кому|лайк,? если)\\b",
   "name": "Дежурная просьба подписаться или отметить",
   "fix": "Попроси одно действие, которое этот пост заслужил. Общая просьба приучает пропускать любые просьбы"
  },
  {
   "id": "new-level",
   "regex": "(?i)\\bна (?:новый|следующий|другой) уровень\\b",
   "name": "«На новый уровень» (наше)",
   "fix": "Скажи, что конкретно станет лучше и на сколько"
  },
  {
   "id": "yavlyaetsya",
   "regex": "(?i)\\bявля(?:ется|ются|лся|лась|лось|лись)\\b",
   "name": "Канцелярит «является» (наше)",
   "fix": "Скажи «это» или перестрой фразу. Вслух так никто не говорит"
  },
  {
   "id": "davayte",
   "regex": "(?im)^\\s*давайте (?:рассмотрим|поговорим|посмотрим|узнаем|обсудим)\\b",
   "name": "Зачин «Давайте рассмотрим» (наше)",
   "fix": "Сразу говори то, что собирался рассмотреть"
  },
  {
   "id": "ty-vy",
   "regex": "(?i)\\b(?:вы|вас|вам|вами|ваш|ваша|ваше|ваши|вашего|вашей|вашу|ваших)\\b",
   "name": "«Вы» вместо «ты» (наше)",
   "fix": "Автор говорит на «ты». «Вы» оставь только в ответе бренду или незнакомому человеку, если так начал он",
   "report_only": true
  }
 ]
}